# syntax=docker/dockerfile:1.7
#
# For working on the code. The source is not in the image: compose mounts the folders
# gtfstoosm/ and tests/ of the disk, so a change is seen at once, with no rebuild.
# The container starts a watcher that runs the tests again at each change.
# See docker-compose.yml (profile dev) and Dockerfile for using the tool.

FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends osmium-tool \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PYTHONPATH=/app \
    WATCHFILES_FORCE_POLLING=true \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-install-project --no-dev \
    && uv pip install --python /opt/venv/bin/python pytest ruff watchfiles

COPY --chmod=755 docker/gtfstoosm /usr/local/bin/gtfstoosm

# Files on a Windows disk do not notify the container of changes: they are polled
CMD ["watchfiles", "--filter", "python", "pytest -q -m 'not slow' -p no:cacheprovider", "/app/gtfstoosm", "/app/tests"]
